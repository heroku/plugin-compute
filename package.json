{
  "name": "@heroku/plugin-compute",
  "description": "CLI for Compute",
  "version": "0.4.1",
  "author": "Heroku",
  "bugs": "https://github.com/heroku/plugin-compute/issues",
  "dependencies": {
    "@oclif/core": "^4",
    "@salesforce/core": "^8.32.6",
    "@salesforce/kit": "^4.0.8",
    "@salesforce/sf-plugins-core": "^12",
    "@salesforce/source-deploy-retrieve": "^12.37.2",
    "form-data": "^4.0.6",
    "ignore": "^7.0.13",
    "jszip": "^3.10.1",
    "openapi-fetch": "^0.17.0",
    "tar-stream": "^3.2.1"
  },
  "devDependencies": {
    "@heroku-cli/test-utils": "2.0.0-beta.0",
    "@oclif/plugin-command-snapshot": "^6.0.6",
    "@salesforce/cli-plugins-testkit": "^5.3.78",
    "@typescript-eslint/parser": "^8.72.0",
    "@types/node": "^22",
    "@types/sinon": "22.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.13.0",
    "eslint-config-oclif": "^7",
    "linkinator": "^8.1.0",
    "oclif": "^6.0.10",
    "openapi-typescript": "^7.13.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^7",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "/dist",
    "/messages",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json",
    "/schemas"
  ],
  "homepage": "https://github.com/heroku/plugin-compute",
  "keywords": [
    "force",
    "salesforce",
    "salesforcedx",
    "sf",
    "sf-plugin",
    "sfdx",
    "sfdx-plugin"
  ],
  "license": "Apache-2.0",
  "oclif": {
    "commands": "./dist/commands",
    "bin": "sf",
    "topicSeparator": " ",
    "devPlugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-command-snapshot"
    ],
    "topics": {
      "compute": {
        "description": "Manage Salesforce Compute apps."
      },
      "compute:get": {
        "description": "Retrieve read-only data about a compute app."
      },
      "compute:set": {
        "description": "Set a compute app's config vars."
      },
      "compute:tail": {
        "description": "Stream a compute app's output as it is produced."
      },
      "compute:unset": {
        "description": "Unset a compute app's config vars."
      }
    },
    "flexibleTaxonomy": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heroku/plugin-compute"
  },
  "scripts": {
    "clean": "rimraf dist tmp oclif.manifest.json *.tsbuildinfo .eslintcache",
    "clean-all": "rimraf dist tmp oclif.manifest.json *.tsbuildinfo .eslintcache node_modules",
    "compile": "tsc -p . --pretty --incremental",
    "build": "tsc -p . --pretty --incremental",
    "manifest": "oclif manifest",
    "readme": "oclif readme",
    "docs:generate": "npm run build && npm run manifest && oclif readme --output-dir docs --multi",
    "generate:types": "openapi-typescript api-specs/salesforce-connect-compute.yaml -o src/generated/salesforce-connect-compute.d.ts && openapi-typescript api-specs/heroku-platform-api.yaml -o src/generated/heroku-platform-api.d.ts",
    "lint": "eslint src test --color --cache --cache-location .eslintcache",
    "link-check": "node -e \"process.exit(process.env.CI ? 0 : 1)\" || linkinator \"**/*.md\" --skip \"CHANGELOG.md|node_modules|test/|confluence.internal.salesforce.com|my.salesforce.com|localhost|%s\" --markdown --retry --directory-listing --verbosity error",
    "test:compile": "tsc -p ./test --pretty",
    "test:only": "vitest run --coverage",
    "test:deprecation-policy": "npm run compile && node --loader ts-node/esm --no-warnings=ExperimentalWarning ./bin/dev.js snapshot:compare",
    "test:json-schema": "node --loader ts-node/esm --no-warnings=ExperimentalWarning ./bin/dev.js schema:compare",
    "//test": "The test:command-reference gate was removed from this chain until @salesforce/plugin-command-reference can be reinstalled without its vulnerable transitive deps; see AGENTS.md for restore steps.",
    "test": "npm run test:compile && npm run test:only && npm run test:deprecation-policy && npm run test:json-schema && npm run link-check",
    "test:nuts": "vitest run --config vitest.nut.config.ts",
    "prepare": "npm run build && oclif manifest",
    "prepack": "npm shrinkwrap",
    "postpack": "rimraf oclif.manifest.json npm-shrinkwrap.json"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "overrides": {
    "fast-uri": "^3.1.9",
    "@jsforce/jsforce-node": "^3.10.27",
    "typescript": "$typescript",
    "http-cache-semantics": "^4.3.0"
  },
  "exports": "./dist/index.js",
  "type": "module"
}
