{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ComputeListResult",
  "definitions": {
    "ComputeListResult": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ComputeAppSummary"
      }
    },
    "ComputeAppSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "masterLabel": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["DEPLOYING", "ACTIVE", "FAILED"]
        },
        "statusReason": {
          "type": "string"
        },
        "externalServiceId": {
          "type": "string"
        },
        "externalServiceRegistered": {
          "type": "boolean"
        },
        "externalServiceActive": {
          "type": "boolean"
        },
        "currentBuild": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "buildStatus": {
              "type": "string",
              "enum": ["PENDING", "BUILDING", "SUCCEEDED", "FAILED"]
            },
            "buildStartedAt": {
              "type": "string"
            },
            "buildCompletedAt": {
              "type": "string"
            },
            "deployedAt": {
              "type": "string"
            },
            "deployedBy": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          },
          "required": ["id", "buildStatus"],
          "additionalProperties": false
        }
      },
      "required": ["id", "name", "masterLabel", "status", "externalServiceRegistered"],
      "additionalProperties": false
    }
  }
}
