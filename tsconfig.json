{
  "compilerOptions": {
    // Inlined from @salesforce/dev-config/tsconfig-strict-esm (retired with
    // @salesforce/dev-scripts); matches the zero-`extends` pattern the Heroku fleet uses.
    // NodeNext (vs dev-config's frozen Node16) tracks current Node resolution semantics,
    // which fits this plugin's engines.node >=22 floor.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2024",
    "lib": ["es2024"],
    "sourceMap": true,
    "declaration": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "strict": true,
    // Skip type-checking third-party .d.ts files. Upstream @types drift (e.g. @types/sinon
    // vs a newer @sinonjs/fake-timers, @salesforce/core vs pino, @types/cacheable-request vs
    // keyv) otherwise fails our compile with errors we can't fix and don't own. This matches
    // test/tsconfig.json and is the standard posture for a library consuming floating @types.
    "skipLibCheck": true,
    "outDir": "lib",
    "rootDir": "src",
    // @salesforce/source-deploy-retrieve's own .d.ts imports a co-located .json registry file
    // (registry/standardvalueset.d.ts -> ./stdValueSetRegistry.json) without this flag set.
    "resolveJsonModule": true
  },
  // bin/dev.js and the test:command-reference/snapshot/schema steps run via ts-node/esm.
  "ts-node": {
    "esm": true
  },
  "include": ["./src/**/*.ts"]
}
