{
  "compilerOptions": {
    // Strict-esm base plus noEmit for a typecheck-only pass over the test sources.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2024",
    "lib": ["es2024"],
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "ts-node": {
    "esm": true
  },
  "include": ["./**/*.ts"]
}
