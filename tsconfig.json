{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2024",
    "lib": ["es2024"],
    "sourceMap": true,
    "declaration": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true
  },
  "ts-node": {
    "esm": true
  },
  "include": ["./src/**/*.ts"]
}
