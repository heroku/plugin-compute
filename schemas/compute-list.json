{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ComputeListResult",
  "definitions": {
    "ComputeListResult": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ComputeAppSummary"
      }
    },
    "ComputeAppSummary": {
      "type": "object",
      "properties": {
        "currentBuild": {
          "type": "object",
          "properties": {
            "buildCompletedAt": {
              "type": "string"
            },
            "buildStartedAt": {
              "type": "string"
            },
            "buildStatus": {
              "type": "string",
              "enum": [
                "BUILDING",
                "FAILED",
                "PENDING",
                "SUCCEEDED"
              ]
            },
            "deployedAt": {
              "type": "string"
            },
            "deployedBy": {
              "type": "string"
            },
            "error": {
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "buildStatus",
            "id"
          ],
          "additionalProperties": false
        },
        "description": {
          "type": "string"
        },
        "externalServiceActive": {
          "type": "boolean"
        },
        "externalServiceId": {
          "type": "string"
        },
        "externalServiceRegistered": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "masterLabel": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "DEPLOYING",
            "FAILED"
          ]
        },
        "statusReason": {
          "type": "string"
        }
      },
      "required": [
        "externalServiceRegistered",
        "id",
        "masterLabel",
        "name",
        "status"
      ],
      "additionalProperties": false
    }
  }
}