{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ComputeDisplayResult",
  "definitions": {
    "ComputeDisplayResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formation": {
          "$ref": "#/definitions/HerokuFormationSummary"
        },
        "name": {
          "type": "string"
        },
        "masterLabel": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["DEPLOYING", "ACTIVE", "FAILED"]
        },
        "statusReason": {
          "type": "string"
        },
        "externalServiceRegistered": {
          "type": "boolean"
        },
        "externalServiceActive": {
          "type": "boolean"
        },
        "currentBuild": {
          "type": "object",
          "properties": {
            "buildStatus": {
              "type": "string",
              "enum": ["PENDING", "BUILDING", "SUCCEEDED", "FAILED"]
            },
            "buildStartedAt": {
              "type": "string"
            },
            "buildCompletedAt": {
              "type": "string"
            },
            "deployedAt": {
              "type": "string"
            },
            "deployedBy": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          },
          "required": ["buildStatus"],
          "additionalProperties": false
        }
      },
      "required": ["externalServiceRegistered", "masterLabel", "name", "status"]
    },
    "HerokuFormationSummary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "dynoSize": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        },
        "required": ["type", "quantity"],
        "additionalProperties": false
      }
    }
  }
}
